APP_NAME=State-Adaptive Panchang API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400
